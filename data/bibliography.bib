  author = {Chen, Jianfei and Nguyen, Minh-Khai and Yao, Zhigang and Wang, Caisheng and Gao, Le and Hu, Gangyi},
  year = {2021},
  month = jun,
  journal = {IEEE Electrification Magazine},
  volume = {9},
  number = {2},
  pages = {10--22},
  issn = {2325-5889},
  doi = {10.1109/MELE.2021.3070934},
  abstract = {DC-DC CONVERTERS ARE SOLID-STATE DC "transformers" that convert one type of dc electricity into another via power electronic circuits. They have been used in a broad range of applications, from IT devices (such as a power supply to provide different dc voltage levels inside a personal computer or a data center server) to medical equipment (e.g., a solar charger for a cardiac pacemaker) and from consumer electronics (e.g., chargers for various smart mobile devices) to high-power industrial applications, which is the focused area of this article. As there has been exponential growth in transportation electrification since the beginning of the 21st century, dc-dc converters have become one of the core devices in electric and autonomous vehicles. Extensive research and development efforts have been made on the design and implementation of dc-dc converters, aiming at higher power density, higher efficiency, and more reduction in cost. In this article, various dc-dc converter topologies and control methodologies for transportation electrification are reviewed. The challenges and future development trends for creating the next-generation dc-dc power converters are also discussed.},
  keywords = {Computational modeling,DC-DC power converters,Density measurement,Power electronics,Power supplies,Power system measurements,Reliability engineering,Transportation},
  annotation = {GSCC: 0000045}
}

@inproceedings{gandluru_identifying_2024,
  title = {Identifying Suitable {{PSFB}} Topology for {{HVLV}} Auxiliary Power Supply ({{APS}}) Application in Evs},
  booktitle = {2024 {{IEEE Applied Power Electronics Conference}} and {{Exposition}} ({{APEC}})},
  author = {Gandluru, Veera Bharath and Autkar, Komal and Hu, Yuequan},
  year = {2024},
  month = feb,
  pages = {2069--2076},
  issn = {2470-6647},
  doi = {10.1109/APEC48139.2024.10509472},
  abstract = {Electric vehicles (EVs) uses a DC/DC converter, known as the Auxiliary Power Supply (APS), to supply power to low-voltage auxiliary loads from high-voltage battery. Typically, low-voltage systems operate at 12 volts, while high-voltage systems function at 400V or 800V. In response to the evolving landscape of electric vehicle infrastructure, the industry is pushing the power limits of the DC/DC converter to meet with the requirements of newly incorporated loads. The Phase-Shifted Full-Bridge(PSFB) based DC/DC converter is the most preferred topology for the APS application. This study explores various popular PSFB topologies to determine the most suitable converter for the APS application in EVs. An in-depth topological analysis is conducted to understand the pros and cons of each PSFB version. Finally, different PSFB converters are designed, and detailed loss analysis for various components is performed to determine the most efficient PSFB converter.},
  keywords = {_star,Auxiliary Power Supply (APS),center-Tapped,current-doubler,Electric vehicles,full-bridge rectifier,High-voltage techniques,Industries,Low voltage,Phase-Shift Full-Bridge (PSFB),Power electronics,Power supplies,Rectifiers},
  annotation = {GSCC: 0000001}
}

