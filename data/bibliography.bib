@phdthesis{hou_variable_nodate,
  title = {Variable {{Ratio Matrix Transformer}} Based {{LLC Converter}} for {{Two-Stage Low-Voltage DC-DC Converter Efficiency Improvement}}},
  author = {Hou, Zhengming},
  abstract = {The low-voltage dc-dc converter (LDC) in electrical vehicles (EVs) is to convert high dc voltage (270V{\textasciitilde}430V) from traction battery to low dc voltage (12.5V{\textasciitilde}15.5V) for the vehicle auxiliary systems. A galvanic isolation is required in the LDC due to the safety consideration. Three challenges exist in the LDC design: (1) wide regulation range; (2) high output current; (3) thermal management. The single stage solutions, such as phaseshift full bridge converter and LLC resonant converter, have been widely studied in the past. A matrix transformer is widely adopted in single stage LDC design to deal with the large current. At last, the low-profile design allows large footprint area for high power density and ease of cooling design.},
  school = {Virginia Tech},
  annotation = {GSCC: 0000000}
}

