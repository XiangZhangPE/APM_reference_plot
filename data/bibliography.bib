@inproceedings{gandluru_identifying_2024,
  title = {Identifying Suitable {{PSFB}} Topology for {{HVLV}} Auxiliary Power Supply ({{APS}}) Application in Evs},
  booktitle = {2024 {{IEEE Applied Power Electronics Conference}} and {{Exposition}} ({{APEC}})},
  author = {Gandluru, Veera Bharath and Autkar, Komal and Hu, Yuequan},
  year = {2024},
  month = feb,
  pages = {2069--2076},
  issn = {2470-6647},
  doi = {10.1109/APEC48139.2024.10509472},
  abstract = {Electric vehicles (EVs) uses a DC/DC converter, known as the Auxiliary Power Supply (APS), to supply power to low-voltage auxiliary loads from high-voltage battery. Typically, low-voltage systems operate at 12 volts, while high-voltage systems function at 400V or 800V. In response to the evolving landscape of electric vehicle infrastructure, the industry is pushing the power limits of the DC/DC converter to meet with the requirements of newly incorporated loads. The Phase-Shifted Full-Bridge(PSFB) based DC/DC converter is the most preferred topology for the APS application. This study explores various popular PSFB topologies to determine the most suitable converter for the APS application in EVs. An in-depth topological analysis is conducted to understand the pros and cons of each PSFB version. Finally, different PSFB converters are designed, and detailed loss analysis for various components is performed to determine the most efficient PSFB converter.},
  keywords = {_star,Auxiliary Power Supply (APS),center-Tapped,current-doubler,Electric vehicles,full-bridge rectifier,High-voltage techniques,Industries,Low voltage,Phase-Shift Full-Bridge (PSFB),Power electronics,Power supplies,Rectifiers},
  annotation = {GSCC: 0000001}
}

@inproceedings{ding_self-adaptive_2021,
  title = {Self-Adaptive Synchronous Rectifier Control Algorithm of Phase-Shifted Full Bridge Current Double Rectifier Converter},
  booktitle = {2021 {{IEEE}} 1st {{International Power Electronics}} and {{Application Symposium}} ({{PEAS}})},
  author = {Ding, Qiang and Gao, Yihan and Ma, Hao},
  year = {2021},
  month = nov,
  pages = {1--6},
  doi = {10.1109/PEAS53589.2021.9628554},
  abstract = {Phase shifted full bridge current double rectifier (PSFB-CDR) converter are widely used as auxiliary DC/DC power supplies. In this paper, a self-adaptive synchronous rectification (SR) method is proposed. The method can adjust the driving signals of synchronous rectifier switches over various output voltages and power levels to achieve synchronous rectification. This benefits to reduce the conduction losses of SR switches and to improve converter efficiency. The final result of presented strategy is simple, which is practical for implementation. Experimental results are given to verify the effectiveness of the proposed method.},
  keywords = {Bridge circuits,Current Double Rectifier Converter,Electric Vehicle,Power electronics,Power supplies,Rectifiers,Synchronous Rectifier Technology},
