@inproceedings{mukherjee_multiport_2024,
  title = {Multiport Converter Based Auxiliary Power Supply for Heavy Duty Fuel Cell Power Train},
  booktitle = {2024 {{IEEE Transportation Electrification Conference}} and {{Expo}} ({{ITEC}})},
  author = {Mukherjee, Subhajyoti and Sujan, Vivek and Chowdhury, Shajjad and Onar, Omer},
