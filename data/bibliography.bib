  abstract = {Aiming at improving the dynamic response, this paper proposed a fixed-frequency phase shifted strategy with feed-forward control for the dual-active-bridge series resonant converter. By applying the time-domain analysis, the analytical expression of the voltage gain is obtained, which consists of the phase shifted angle and the frequency. Correspondingly, a feedforward controller is proposed, which can be combined with a conventional proportional integral controller so to significantly accelerate the converter dynamic response. A 1.2kW prototype is built to verify the theoretical analysis, which is in accordance with the theoretical conclusions.},
  keywords = {dual-active-bridge series resonant converter (DABSRC),feedforward control,Feedforward systems,Prototypes,Resonant converters,series resonant converter (SRC),time domain analysis (TDA),Time-domain analysis,Time-frequency analysis,Topology,Voltage control},
